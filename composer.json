{
    "name": "curso-pruebas/pronosticos-php",
    "description": "Cálculo de pronósticos de demanda y de sus medidas de error para el curso de Pruebas de Software.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "behat/behat": "^3.14",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Pronosticos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pronosticos\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public"
        ],
        "test:unit": "phpunit --testsuite unit",
        "test:bdd": "behat",
        "lint": "phpstan analyse",
        "test:cobertura": "phpunit --coverage-text --coverage-clover coverage.xml"
    },
    "config": {
        "sort-packages": true
    }
}
