<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de PHPUnit.
  bootstrap: carga el autoloader de Composer para que las pruebas encuentren las clases.
  testsuites: agrupa las pruebas; "unit" se ejecuta con: composer test:unit
  source: el código que se mide al pedir cobertura.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
